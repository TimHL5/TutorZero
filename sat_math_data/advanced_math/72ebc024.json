      "id": "4434c4c1-d8ee-4555-bd85-921660c9b511",
      "content": "<p><math alttext=\"14 x y left parenthesis 2 x squared y plus 1 right parenthesis\"><mrow>\n\t<mn>14</mn>\n\t<mi>x</mi>\n\t<mi>y</mi>\n\t<mfenced>\n\t\t<mrow>\n\t\t\t<mrow>\n\t\t\t\t<mn>2</mn>\n\t\t\t\t<msup>\n\t\t\t\t\t<mi>x</mi>\n\t\t\t\t\t<mn>2</mn>\n\t\t\t\t</msup>\n\t\t\t\t<mi>y</mi>\n\t\t\t</mrow>\n\t\t\t<mo>+</mo>\n\t\t\t<mn>1</mn>\n\t\t</mrow>\n\t</mfenced>\n</mrow>\n</math></p>"
