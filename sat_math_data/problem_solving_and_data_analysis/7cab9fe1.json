  "stem": "<p style=\"text-align: left;\">Which expression represents the result of increasing a positive quantity <math alttext=\"w\"><mi>w</mi>\n</math> by <math alttext=\"43 percent sign\"><mrow><mn>43</mn></mrow><mo>%</mo></math>?</p>",
  "answerOptions": [
    {
      "id": "b753ff76-cd14-4bee-9255-e7216e59e85a",
      "content": "<p><math alttext=\"1.43 w\"><mrow><mn>1.43</mn></mrow><mi>w</mi></math></p>"
    },
    {
