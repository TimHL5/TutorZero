# TutorZero local environment — copy to .env.local and fill in.

# ── OpenAI ────────────────────────────────────────────────────────────────
# Powers all AI features (tutor chat, diagnostician, coach, explainer, planner).
OPENAI_API_KEY=
# Optional override — the tutor agent defaults to gpt-4o when this is unset.
# OPENAI_MODEL_STRONG=gpt-4o

# ── Supabase ──────────────────────────────────────────────────────────────
# Server-side Postgres access used by the worker. The publishable URL +
# anon key are hardcoded in src/worker/index.ts (safe — they're public).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tavily web search ─────────────────────────────────────────────────────
# Used by the tutor's `searchWeb` tool to look up SAT test dates, College
# Board policy, score release schedules, and external study resources.
# Free tier = 1000 queries/month — sign up at https://tavily.com.
# When unset, the tool returns a "temporarily unavailable" message instead
# of crashing; the tutor will redirect the student to collegeboard.org.
TAVILY_API_KEY=

# ── Stripe (optional — only for billing flows) ────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
