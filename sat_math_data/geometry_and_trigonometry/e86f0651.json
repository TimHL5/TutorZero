      "id": "d062e2a0-f472-4b8e-9d0c-9a7b9efc565c",
      "content": "<p><math alttext=\"StartFraction 43 pi Over 2 EndFraction\"><mrow>\n\t<mfrac>\n\t\t<mrow>\n\t\t\t<mn>43</mn>\n\t\t\t<mi>&pi;</mi>\n\t\t</mrow>\n\t\t<mn>2</mn>\n\t</mfrac>\n</mrow>\n</math></p>"
