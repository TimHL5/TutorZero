  "stimulus": null,
  "stem": "<p style=\"text-align: left;\">A rectangle has a length of <math alttext=\"64\"><mn>64</mn>\n</math> inches and a width of <math alttext=\"32\"><mn>32</mn>\n</math> inches. What is the area, in square inches, of the rectangle?</p>",
  "answerOptions": [],
